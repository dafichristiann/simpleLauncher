<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base window theme: cream background, no action bar, edge-to-edge. -->
    <style name="Theme.SoftHome" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/soft_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Launcher-specific: transparent window so the wallpaper/cream shows through
         during launch (avoids a white flash) and the home paints on top. -->
    <style name="Theme.SoftHome.Transparent" parent="Theme.SoftHome">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

</resources>
